{
  "name": "flight-log-remastered",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:auth-schema": "auth generate --config src/lib/auth/schema.config.ts --adapter drizzle --dialect postgresql --output src/lib/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mts",
    "generate:icons": "tsx scripts/generate-icons.mts",
    "check:verify-waits": "tsx scripts/check-verify-waits.mts",
    "check:parsers": "tsx scripts/check-parsers.mts",
    "check:barogram": "tsx scripts/check-barogram.mts",
    "check:track-gradient": "tsx scripts/check-track-gradient.mts",
    "check:track-hover": "tsx scripts/check-track-hover.mts",
    "check:scoring": "tsx scripts/check-scoring.mts",
    "check:follow-button": "tsx scripts/check-follow-button.mts",
    "check:feed": "tsx scripts/check-feed.mts",
    "check:watermark-store": "tsx scripts/check-watermark-store.mts",
    "check:seen-trip-store": "tsx scripts/check-seen-trip-store.mts",
    "check:request-gate": "tsx scripts/check-request-gate.mts",
    "check:takeoffs-prerender": "tsx scripts/check-takeoffs-prerender.mts",
    "check:clubs-prerender": "tsx scripts/check-clubs-prerender.mts",
    "test": "vitest run",
    "check": "tsc --noEmit && pnpm check:verify-waits && pnpm check:parsers && pnpm check:barogram && pnpm check:track-gradient && pnpm check:track-hover && pnpm check:scoring && pnpm check:follow-button && pnpm check:feed && pnpm check:watermark-store && pnpm check:seen-trip-store && pnpm check:request-gate && pnpm check:takeoffs-prerender && pnpm check:clubs-prerender && pnpm test"
  },
  "dependencies": {
    "better-auth": "^1.7.16",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.34.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.12",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.19.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "auth": "^1.7.16",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
